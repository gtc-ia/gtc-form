# Server
PORT=8085
NODE_ENV=production
ALLOWED_ORIGINS=https://app.gtstor.com,https://www.gtstor.com

# PostgreSQL (direct)
PGHOST=localhost
PGPORT=5432
PGDATABASE=gtc_db
PGUSER=gtc_user
PGPASSWORD=gtc_pass

# SMTP
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@gtchain.io
SMTP_PASS=REPLACE_WITH_REAL
MAIL_FROM="GTC Accounts <noreply@gtchain.io>"

# Public URLs
APP_BASE_URL=https://app.gtstor.com
VERIFY_PATH=/verify
PAYMENT_PORTAL_URL=https://pay.gtstor.com/payment.php
CHAT_REDIRECT_PATH=/chat/

# Google
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID

# Security
RATE_WINDOW_MS=60000
RATE_MAX=60
BCRYPT_ROUNDS=12
AUTH_COOKIE_NAME=gtc_post_auth
AUTH_COOKIE_DOMAIN=.gtstor.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_MAX_AGE_MS=600000
SUBSCRIPTION_STALENESS_GRACE_MS=1209600000

